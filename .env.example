# BanaoCV Environment Configuration
# Copy this file to .env and fill in your keys only

# ═══════════════════════════════════════════════════════════
# AI CONFIG
# ═══════════════════════════════════════════════════════════
# Your AI service API key (e.g., OpenAI, Claude, Gemini)
AI_API_KEY=sk-your-ai-api-key-here
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are BanaoCV AI assistant. Help users create professional resumes in English based on their Hindi input.

# ═══════════════════════════════════════════════════════════
# AUTH CONFIG
# ═══════════════════════════════════════════════════════════
# Firebase / Auth0 / Custom auth credentials
AUTH_PROVIDER=firebase
AUTH_API_KEY=your-auth-api-key
AUTH_DOMAIN=your-project.firebaseapp.com
AUTH_PROJECT_ID=your-project-id
AUTH_STORAGE_BUCKET=your-project.appspot.com
AUTH_MESSAGING_SENDER_ID=123456789
AUTH_APP_ID=1:123456789:web:abcdef1234567890abcdef
AUTH_MEASUREMENT_ID=G-ABCDEF123

# Alternative: Custom JWT
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRY=7d

# ═══════════════════════════════════════════════════════════
# PAYMENT CONFIG
# ═══════════════════════════════════════════════════════════
# Razorpay credentials (India's #1 payment gateway)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Alternative: Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ═══════════════════════════════════════════════════════════
# APP CONFIG
# ═══════════════════════════════════════════════════════════
APP_URL=https://banaocv.in
APP_NAME=BanaoCV
APP_SUPPORT_EMAIL=support@banaocv.in
APP_LOGO_URL=https://banaocv.in/assets/logo.svg

# ═══════════════════════════════════════════════════════════
# FEATURES
# ═══════════════════════════════════════════════════════════
FEATURE_DARK_MODE=true
FEATURE_AI_RESUME=true
FEATURE_PAYMENT_PREMIUM=true
FEATURE_ANALYTICS=true
